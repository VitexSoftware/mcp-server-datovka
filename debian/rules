#!/usr/bin/make -f

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install --destdir=debian/mcp-server-datovka

override_dh_auto_test:
	appstreamcli validate --no-net debian/mcp-server-datovka.metainfo.xml
	# Skip pybuild's default unittest discovery: tests/test_server.py uses
	# pytest, which isn't packaged as a build-dependency here.

override_dh_install:
	dh_install
	install -D -m644 debian/mcp-server-datovka.metainfo.xml \
		debian/mcp-server-datovka/usr/share/metainfo/io.github.vitexsoftware.mcp-server-datovka.metainfo.xml
	install -D -m644 mcp-server-datovka.svg \
		debian/mcp-server-datovka/usr/share/icons/hicolor/scalable/apps/mcp-server-datovka.svg
