# Czech ISDS Data Box (Datové schránky) MCP server
# Copy to .env and fill in real credentials. Never commit .env.

# SOAP endpoint — trailing slash is required by libdatovka.
# Production (default when unset):
DATOVKA_URL=https://ws1.mojedatovaschranka.cz/
# Testing sandbox (prefer for development when you have a test box):
# DATOVKA_URL=https://ws1.czebox.cz/
# Newer testing alias (same sandbox):
# DATOVKA_URL=https://ws1.datovka-test.gov.cz/

DATOVKA_USERNAME=your-isds-username
DATOVKA_PASSWORD=your-isds-password

# Block send_message / send_text_message / mark_message_read (default: true).
READ_ONLY=true
